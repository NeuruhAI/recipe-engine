{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "neuruh.recipe-engine.eligibility-policy.v1",
  "title": "EligibilityPolicy",
  "description": "One recipe version's eligibility predicates. Each clause names one canonical signal type, the state it expects, and whether bound negative evidence is decisive (NO_MATCH) or merely negative evidence (UNKNOWN). policy_digest binds the evaluation body; composition_digest binds the ingredient list exactly as lead-recipe-os recomputes it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant_id",
    "recipe_id",
    "recipe_version_id",
    "version",
    "validity_seconds",
    "clauses",
    "composition",
    "policy_digest",
    "composition_digest"
  ],
  "properties": {
    "schema_version": {"const": "neuruh.recipe-engine.eligibility-policy.v1"},
    "tenant_id": {"type": "string", "minLength": 1},
    "recipe_id": {"type": "string", "minLength": 1},
    "recipe_version_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "validity_seconds": {"type": "integer", "minimum": 1},
    "clauses": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/clause"}
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ingredients", "policy_contract"],
      "properties": {
        "ingredients": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "policy_contract": {"const": "neuruh.recipe-engine.eligibility-policy.v1"}
      }
    },
    "policy_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "composition_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "clause": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clause_id",
        "signal_type",
        "expect",
        "negative_evidence_decisive",
        "min_confidence",
        "max_age_seconds"
      ],
      "properties": {
        "clause_id": {"type": "string", "minLength": 1},
        "signal_type": {
          "enum": [
            "absentee_owner",
            "code_violation",
            "government_owner",
            "long_hold",
            "marketability_risk",
            "pre_foreclosure",
            "probate_or_estate",
            "tax_delinquent",
            "title_conflict",
            "vacancy",
            "value_spread"
          ]
        },
        "expect": {"enum": ["PRESENT", "ABSENT"]},
        "negative_evidence_decisive": {
          "type": "boolean",
          "description": "true: bound evidence of the opposite state is the opposite fact and yields NO_MATCH. false: it is negative evidence only and leaves the clause UNKNOWN."
        },
        "min_confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
        "max_age_seconds": {
          "type": ["integer", "null"],
          "minimum": 1,
          "description": "Freshness boundary for supporting evidence. Older evidence is EVIDENCE_STALE (UNKNOWN), never ABSENT."
        }
      }
    }
  }
}
